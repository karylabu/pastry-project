# React UI with Laravel API and legacy PHP endpoints.
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Laravel handles requests under its public path.
    RewriteRule ^laravel/public/ - [L]

    # Keep private PHP dependencies and includes inaccessible.
    RewriteRule ^(includes|vendor)(/|$) - [F,L]

    # Keep legacy PHP endpoints and staff APIs on their existing handlers.
    RewriteRule ^(customer|staff)/.*\.php$ - [L]
    RewriteRule ^(staff|admin)/api(/.*)?$ - [L]

    # The React build emits root-relative asset URLs.
    RewriteRule ^static/(.*)$ customer_portal/build/static/$1 [L]
    RewriteRule ^(favicon\.ico|pastry-project-favicon\.png|pastry-project-favicon-v2\.png|pastry-project-icon-192\.png|pastry-project-icon-512\.png|logo192\.png|logo512\.png|manifest\.json|robots\.txt|privacy\.html|terms\.html)$ customer_portal/build/$1 [L]

    # React owns the site root and its client-side routes.
    RewriteRule ^$ customer_portal/build/index.html [L]
    RewriteRule ^(customer|admin|staff)/?$ customer_portal/build/index.html [L]

    # Serve existing project files and legacy pages as-is.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule .* - [L]

    # React client-side routes, except existing legacy files handled above.
    RewriteRule ^(customer|admin|staff)(/.*)?$ customer_portal/build/index.html [L]

    # Other application routes go through Laravel.
    RewriteRule ^ laravel/public/index.php [L]
</IfModule>
