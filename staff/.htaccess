# Pass the Authorization header through to PHP.
# Under some Apache setups (CGI/FastCGI/proxy) the header is stripped from
# PHP's $_SERVER, which breaks Bearer-token authentication for API clients.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP:Authorization} ^(.+)$
  RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
</IfModule>

<Files "sms_log.txt">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>